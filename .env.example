# نمونه فایل env — این فایل رو کپی کن به .env و مقادیر واقعی رو پر کن.
# .env هرگز نباید commit یا برای کسی ارسال بشه (توی .gitignore هست).
#
# در حال حاضر بخش‌هایی که نیاز به ثبت‌نام/اقدام بیرونی دارن (زیبال، دامنه،
# SMTP واقعی) خالی گذاشته شدن. تا وقتی خالی/نامعتبر باشن، برنامه به‌صورت
# خودکار به حالت امن/آزمایشی سقوط می‌کنه (سندباکس پرداخت، ایمیل توی لاگ) —
# یعنی همین الان هم بدون این مقادیر کامل اجرا می‌شه.

# ---------- هسته‌ی برنامه (اجباری در production) ----------
APP_ENV=development
# برای production: APP_ENV=production
# و SECRET_KEY اجباری می‌شه (تولید: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=

# ---------- دیتابیس ----------
# پیش‌فرض: sqlite:///data/library.db
# برای production با PostgreSQL:
# DATABASE_URL=postgresql://library_user:CHANGE_ME@db:5432/digital_library
DATABASE_URL=

# ---------- دامنه / کوکی امن ----------
# بعد از داشتن دامنه‌ی واقعی:
# SITE_BASE_URL=https://your-domain.example
SITE_BASE_URL=
# در production خودکار true می‌شه؛ فقط اگه پشت پراکسی خاصی هستی دستی ست کن
SESSION_COOKIE_SECURE=

# ---------- ایمیل (SMTP) ----------
# تا وقتی خالیه، متن ایمیل‌ها فقط توی logs/digital_library.log نوشته می‌شه.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=1
MAIL_SENDER=

# ---------- درگاه پرداخت (زیبال) ----------
# تا وقتی مرچنت واقعی نداری، همینو بذار sandbox — کل مسیر خرید بدون پول واقعی تست می‌شه.
# روز ثبت‌نام زیبال، فقط این دو خط رو عوض کن، هیچ تغییر کدی لازم نیست:
PAYMENT_MODE=sandbox
ZIBAL_MERCHANT=zibal

# ---------- مانیتورینگ خطا (اختیاری، برای وقتی سایت آنلاین شد) ----------
# از https://sentry.io یه پروژه‌ی رایگان بساز و DSN رو اینجا بذار.
# تا وقتی خالیه، این قابلیت کلاً غیرفعاله و هیچ اثری نداره.
SENTRY_DSN=

# ---------- PostgreSQL (فقط وقتی از docker-compose.yml استفاده می‌کنی) ----------
POSTGRES_DB=digital_library
POSTGRES_USER=library_user
POSTGRES_PASSWORD=CHANGE_ME
